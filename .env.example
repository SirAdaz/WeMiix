# =====================================================
# WeMiix — Variables d'environnement
# Copier ce fichier : cp .env.example .env
# NE PAS committer le fichier .env !
# =====================================================

# --- PostgreSQL ---
POSTGRES_DB=wemiix_db
POSTGRES_USER=wemiix_user
POSTGRES_PASSWORD=changeme

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=wemiix_user
MONGO_INITDB_ROOT_PASSWORD=changeme

# --- Redis ---
REDIS_PASSWORD=changeme

# --- Spotify OAuth ---
# Créer une app sur : https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- JWT / Better Auth ---
# Générer avec : openssl rand -base64 64
AUTH_SECRET=changeme_at_least_32_chars_long_secret_here

# --- URLs frontend → backend ---
# Développement : accès direct aux ports exposés
# Production   : tout passe par Nginx sur le port 80
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# --- Dev only ---
# Polling Webpack requis dans Docker sur certains OS (Windows/WSL)
WATCHPACK_POLLING=true
